{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conecta-ocho",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "conecta-ocho"
    }
  ],
  "observability": {
    "enabled": true
  }
}
